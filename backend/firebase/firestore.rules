rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && me().active == true; }
    function isCentral() { return active() && me().role == 'CENTRAL'; }
    function inRegion(rid) { return active() && me().regionId == rid; }
    function isRegionLead(rid) { return inRegion(rid) && me().role in ['REGION_MANAGER', 'REGION_ADMIN']; }
    function isRegionManager(rid) { return inRegion(rid) && me().role == 'REGION_MANAGER'; }
    function isSquareLead(rid, sid) { return inRegion(rid) && me().role == 'SQUARE_MANAGER' && me().squareId == sid; }
    function inSquare(rid, sid) { return inRegion(rid) && me().squareId == sid; }
    function lead(rid, sid) { return isCentral() || isRegionLead(rid) || isSquareLead(rid, sid); }

    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || str(d[k], max); }
    function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // ---------- users: created and changed only by the Worker (admin) ----------
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isCentral() ||
        (active() && me().regionId == resource.data.regionId && (
          me().role in ['REGION_MANAGER', 'REGION_ADMIN'] ||
          (me().role == 'SQUARE_MANAGER' && me().squareId == resource.data.squareId))));
      allow write: if false;
    }

    // ---------- directory ----------
    match /regions/{rid} {
      allow read: if isCentral() || inRegion(rid);
      allow create, update: if isCentral() && str(request.resource.data.name, 80);
      allow delete: if false;
    }

    match /squares/{sid} {
      allow read: if isCentral() || inRegion(resource.data.regionId);
      allow create: if (isCentral() || isRegionManager(request.resource.data.regionId))
        && str(request.resource.data.name, 80) && optStr(request.resource.data, 'phone', 20);
      allow update: if (isCentral() || isRegionManager(resource.data.regionId))
        && unchanged(['regionId']) && str(request.resource.data.name, 80);
      allow delete: if false;
    }

    match /camps/{cid} {
      allow read: if isCentral() || isRegionLead(resource.data.regionId) || inSquare(resource.data.regionId, resource.data.squareId);
      allow create: if lead(request.resource.data.regionId, request.resource.data.squareId)
        && str(request.resource.data.name, 80) && optStr(request.resource.data, 'phone', 20);
      allow update: if lead(resource.data.regionId, resource.data.squareId)
        && unchanged(['regionId', 'squareId']) && str(request.resource.data.name, 80);
      allow delete: if false;
    }

    // ---------- tasks ----------
    function taskReader(d) {
      return isCentral() || isRegionLead(d.regionId) || isSquareLead(d.regionId, d.squareId)
        || (active() && (d.assigneeId == request.auth.uid || d.createdBy == request.auth.uid));
    }
    function validTransition(from, to) {
      return (from == 'NEW' && to in ['SEEN', 'IN_PROGRESS'])
        || (from == 'SEEN' && to == 'IN_PROGRESS')
        || (from == 'IN_PROGRESS' && to == 'AWAITING_REVIEW')
        || (from == 'AWAITING_REVIEW' && to in ['APPROVED', 'IN_PROGRESS', 'REJECTED'])
        || (to == 'CANCELLED' && from in ['NEW', 'SEEN', 'IN_PROGRESS', 'AWAITING_REVIEW']);
    }
    function assigneeMove(from, to) {
      return (from == 'NEW' && to in ['SEEN', 'IN_PROGRESS'])
        || (from == 'SEEN' && to == 'IN_PROGRESS')
        || (from == 'IN_PROGRESS' && to == 'AWAITING_REVIEW');
    }

    match /tasks/{tid} {
      allow read: if taskReader(resource.data);

      allow create: if active() && me().role != 'FIELD_STAFF'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'NEW'
        && lead(request.resource.data.regionId, request.resource.data.squareId)
        && str(request.resource.data.title, 120) && request.resource.data.title.size() > 0
        && str(request.resource.data.description, 1000)
        && request.resource.data.priority in ['NORMAL', 'HIGH', 'URGENT'];

      allow update: if active()
        && !(resource.data.status in ['APPROVED', 'REJECTED', 'CANCELLED'])
        && unchanged(['createdBy', 'regionId', 'createdAt'])
        && str(request.resource.data.title, 120) && str(request.resource.data.description, 1000)
        && (
          // الإداري ينفّذ أي انتقال صالح ويعدّل بيانات المهمة
          (lead(resource.data.regionId, resource.data.squareId)
            && (request.resource.data.status == resource.data.status
                || validTransition(resource.data.status, request.resource.data.status)))
          ||
          // المُكلَّف يحرّك الحالة للأمام فقط
          (resource.data.assigneeId == request.auth.uid
            && only(['status', 'updatedAt'])
            && assigneeMove(resource.data.status, request.resource.data.status))
        );

      allow delete: if false;

      match /events/{eid} {
        allow read: if taskReader(get(/databases/$(db)/documents/tasks/$(tid)).data);
        allow create: if taskReader(get(/databases/$(db)/documents/tasks/$(tid)).data)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.toStatus is string
          && optStr(request.resource.data, 'note', 500);
        allow update, delete: if false;
      }

      match /photos/{pid} {
        allow read: if taskReader(get(/databases/$(db)/documents/tasks/$(tid)).data);
        allow create: if taskReader(get(/databases/$(db)/documents/tasks/$(tid)).data)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind in ['BEFORE', 'AFTER']
          && str(request.resource.data.data, 400000);
        allow update, delete: if false;
      }
    }

    // ---------- places: points, camps and managers' residences ----------
    function geo(d) { return d.lat is number && d.lng is number && d.lat >= -90 && d.lat <= 90 && d.lng >= -180 && d.lng <= 180; }
    match /places/{pid} {
      allow read: if active() && (isCentral() || (inRegion(resource.data.regionId)
        && (resource.data.kind != 'HOME' || resource.data.ownerId == request.auth.uid || me().role in ['REGION_MANAGER', 'REGION_ADMIN'])));
      allow create: if active() && me().role != 'FIELD_STAFF' && geo(request.resource.data)
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && request.resource.data.kind in ['HOME', 'POINT']
        && request.resource.data.radius is number && request.resource.data.radius >= 20 && request.resource.data.radius <= 5000
        && (isCentral() || (request.resource.data.regionId == me().regionId
          && (request.resource.data.kind == 'HOME' ? request.resource.data.ownerId == request.auth.uid : isRegionLead(request.resource.data.regionId))));
      allow update, delete: if active() && (isCentral() || (inRegion(resource.data.regionId)
        && (resource.data.ownerId == request.auth.uid || isRegionLead(resource.data.regionId))));
    }

    // ---------- check-ins: presence points on the live map ----------
    match /checkins/{cid} {
      allow read: if active() && (resource.data.userId == request.auth.uid || isCentral()
        || isRegionLead(resource.data.regionId) || isSquareLead(resource.data.regionId, resource.data.squareId));
      allow create: if active() && request.resource.data.userId == request.auth.uid
        && request.resource.data.regionId == me().regionId && geo(request.resource.data)
        && request.resource.data.day is string && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // ---------- recurring task templates (the Worker materialises them) ----------
    match /templates/{tid} {
      allow read: if active() && lead(resource.data.regionId, resource.data.squareId);
      allow create: if active() && me().role != 'FIELD_STAFF' && request.resource.data.createdBy == request.auth.uid
        && lead(request.resource.data.regionId, request.resource.data.squareId)
        && str(request.resource.data.title, 120) && request.resource.data.title.size() > 0
        && str(request.resource.data.description, 1000)
        && request.resource.data.every in ['DAILY', 'WEEKLY']
        && request.resource.data.priority in ['NORMAL', 'HIGH', 'URGENT'];
      allow update: if active() && lead(resource.data.regionId, resource.data.squareId)
        && only(['active', 'title', 'description', 'priority', 'every', 'weekday', 'hour', 'assigneeId']);
      allow delete: if active() && lead(resource.data.regionId, resource.data.squareId);
    }

    // ---------- weekly reports: written by the Worker ----------
    match /weekly/{wid} {
      allow read: if active() && (isCentral() || isRegionLead(resource.data.regionId));
      allow write: if false;
    }

    // ---------- chat ----------
    function isMember(roomId) {
      return signedIn() && request.auth.uid in get(/databases/$(db)/documents/rooms/$(roomId)).data.members;
    }
    function canMessage(other) {
      return isCentral()
        || get(/databases/$(db)/documents/users/$(other)).data.role == 'CENTRAL'
        || get(/databases/$(db)/documents/users/$(other)).data.regionId == me().regionId;
    }

    match /rooms/{roomId} {
      // الأعضاء فقط؛ لا يقرأ المدراء المحادثات الخاصة إلا إن كانوا أعضاء
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // غرف المجموعات تُنشأ من الـ Worker فقط لضمان صحة الأعضاء والمنطقة
      allow create: if active()
        && request.resource.data.type == 'direct'
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && canMessage(request.resource.data.members[0] == request.auth.uid
            ? request.resource.data.members[1] : request.resource.data.members[0]);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && only(['lastMessage', 'lastAt']) && optStr(request.resource.data, 'lastMessage', 200);
      allow delete: if false;

      match /messages/{mid} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'file', 'location', 'voice']
          && optStr(request.resource.data, 'text', 4000)
          && request.resource.data.readBy == [request.auth.uid];
        // إيصالات القراءة فقط: يضيف المستخدم نفسه إلى readBy
        allow update: if isMember(roomId)
          && only(['readBy'])
          && !(request.auth.uid in resource.data.readBy)
          && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
          && request.resource.data.readBy.toSet() == resource.data.readBy.toSet().union([request.auth.uid].toSet());
        allow delete: if false;
      }
    }

    // ---------- SOS ----------
    match /sos/{sid} {
      allow read: if active() && (
        resource.data.senderId == request.auth.uid || isCentral() ||
        isRegionLead(resource.data.regionId) || isSquareLead(resource.data.regionId, resource.data.squareId));
      allow create: if active()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.regionId == me().regionId
        && request.resource.data.status == 'OPEN'
        && optStr(request.resource.data, 'note', 500);
      allow update: if lead(resource.data.regionId, resource.data.squareId)
        && only(['status', 'ackBy', 'updatedAt'])
        && ((resource.data.status == 'OPEN' && request.resource.data.status == 'ACK')
          || (resource.data.status == 'ACK' && request.resource.data.status == 'RESOLVED'));
      allow delete: if false;
    }

    // ---------- audit: written by the Worker only ----------
    match /audit/{id} {
      allow read: if isCentral() || isRegionLead(resource.data.regionId);
      allow write: if false;
    }

    // ---------- FCM tokens ----------
    match /devices/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && (request.method == 'delete' || str(request.resource.data.token, 400));
    }

    // ---------- meetings: rooms created by the Worker, signalling by members ----------
    function isMeetingMember(mid) {
      return signedIn() && request.auth.uid in get(/databases/$(db)/documents/meetings/$(mid)).data.members;
    }
    match /meetings/{mid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;
      match /signals/{sid} {
        allow read: if isMeetingMember(mid) && (resource.data.to == request.auth.uid || resource.data.to == 'all');
        allow create: if isMeetingMember(mid) && request.resource.data.from == request.auth.uid
          && str(request.resource.data.payload, 8000);
        allow update, delete: if false;
      }
    }
  }
}
